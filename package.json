{
  "name": "teamplaner",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Zu- und Absagen für Spiele und Trainings der Bretten Kangaroos (Schüler + Jugend)",
  "author": "Martin Wittemann",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:reset": "node scripts/db-reset.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:seed": "node scripts/db-seed.ts",
    "db:migrate:neon": "node --env-file=.env.neon scripts/db-migrate.ts",
    "db:seed:neon": "node --env-file=.env.neon scripts/db-seed.ts"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/vercel": "^11.0.17",
    "@electric-sql/pglite": "^0.5.13",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "nodemailer": "^10.3.1",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
