---
// Parent season page (mockup: Main.dc.html). Without a valid family cookie it explains how to
// get in: through the personal link.
import Base from '../layouts/Base.astro';
import { LINK_KEY } from 'astro:env/server';
import SeasonView from '../components/SeasonView.tsx';
import { getDb } from '../lib/db/index.ts';
import holidays from '../data/holidays-bw.json';
import { listAbsences } from '../lib/absence.ts';
import { calendarToken, rememberCalendarToken } from '../lib/calendar.ts';
import { FAMILY_COOKIE } from '../lib/cookie.ts';
import { isoDay } from '../lib/format.ts';
import { rememberLink } from '../lib/lost-link.ts';
import { loadSeason } from '../lib/season.ts';

const { guardian } = Astro.locals;
const today = isoDay(new Date().toISOString());
const db = guardian ? await getDb() : undefined;
const children = guardian && db ? await loadSeason(db, guardian.id) : [];
const absences = guardian && db ? await listAbsences(db, guardian.id, today) : [];

// The calendar link follows the personal link in the cookie (lib/calendar.ts)
const accessToken = Astro.cookies.get(FAMILY_COOKIE)?.value;
let calendarUrl: string | undefined;
if (guardian && db && accessToken) {
  await rememberCalendarToken(db, guardian.id, accessToken);
  await rememberLink(db, 'guardian', guardian.id, accessToken, LINK_KEY);
  calendarUrl = new URL(`/kalender/${calendarToken(accessToken)}.ics`, Astro.url).href;
}
const invalidLink = Astro.url.searchParams.get('link') === 'ungueltig';
---

<Base title="Unsere Termine · Bretten Kangaroos" who={guardian?.name}>
  {guardian ? (
    <SeasonView
      client:load
      guardianName={guardian.name}
      initialChildren={children}
      initialAbsences={absences}
      holidays={holidays.holidays}
      today={today}
      calendarUrl={calendarUrl}
    />
  ) : (
    <div class="flex flex-col gap-3 bg-chalk px-4 py-7">
      <p class="label">Teamplaner</p>
      <h1 class="heading text-4xl leading-tight">
        {invalidLink ? 'Link ungültig' : 'Bitte über deinen Link öffnen'}
      </h1>
      <p>
        {invalidLink
          ? 'Dieser Link funktioniert nicht (mehr). Vielleicht wurde er erneuert.'
          : 'Jede Familie hat einen persönlichen Link zu ihren Terminen. Du findest ihn in der Mail vom Trainer.'}
      </p>
      <p>
        <a href="/link">Link verloren? Hier neu anfordern</a>
      </p>
    </div>
  )}
</Base>
