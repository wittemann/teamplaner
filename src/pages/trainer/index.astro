---
// Coach overview of one team (mockup: Trainer-Uebersicht.dc.html): how many children confirmed
// the season, the next game and training, the season matrix, late changes and a WhatsApp text.
// Not yet: reminders and push status – they follow with mail and push.
import Base from '../../layouts/Base.astro';
import {
  confirmedPlayers,
  groupByStatus,
  seasonWhatsAppText,
  statusOf,
  whatsAppShareUrl,
} from '../../lib/answers.ts';
import { coachTeams, teamOverview } from '../../lib/coach.ts';
import { getDb } from '../../lib/db/index.ts';
import { shortDate, time, weekday } from '../../lib/format.ts';
import { needsAnswer } from '../../lib/season.ts';

const { coach } = Astro.locals;
const invalidLink = Astro.url.searchParams.get('link') === 'ungueltig';

const db = await getDb();
const teams = coach ? await coachTeams(db, coach) : [];
const team = teams.find((t) => t.id === Astro.url.searchParams.get('team')) ?? teams[0];
const data = team ? await teamOverview(db, team.id) : undefined;

const games = data?.events.filter((e) => needsAnswer(e.type)) ?? [];
const trainings = data?.events.filter((e) => !needsAnswer(e.type)).slice(0, 6) ?? [];
const players = data?.players ?? [];
const answers = data?.answers ?? [];
const confirmed = confirmedPlayers(games, players, answers).length;
const nextGame = games.find((g) => !g.cancelled);
const next = nextGame && groupByStatus(nextGame, players, answers);
const late = answers
  .filter((a) => a.late)
  .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))
  .map((a) => ({
    ...a,
    player: players.find((p) => p.id === a.playerId)?.name,
    event: data?.events.find((e) => e.id === a.eventId),
  }));
const waText = team && seasonWhatsAppText(team.name, team.season, players.length - confirmed);

// "vs. Heidelberg" → "Heidelberg", "bei Mannheim" → "@ Mannheim": short column heads
const short = (title: string) => title.replace(/^vs\. /, '').replace(/^bei /, '@ ');
const SYMBOL = { in: '✓', out: '✗', open: '–' } as const;
const LABEL = { in: 'dabei', out: 'nicht dabei', open: 'offen' } as const;
---

<Base title="Trainer · Bretten Kangaroos" who={coach && `Trainerbereich · ${coach.name}`} wide>
  {!coach || !team || !data ? (
    <div class="flex flex-col gap-3 bg-chalk px-4 py-7">
      <p class="label">Trainerbereich</p>
      <h1 class="heading text-4xl leading-tight">
        {invalidLink
          ? 'Link ungültig'
          : coach
            ? 'Kein Team zugeordnet'
            : 'Bitte über deinen Link öffnen'}
      </h1>
      <p>
        {coach
          ? 'Dir ist noch kein Team zugeordnet. Bitte bei Martin melden.'
          : 'Der Trainerbereich öffnet sich über deinen persönlichen Trainer-Link.'}
      </p>
    </div>
  ) : (
    <>
      <div class="border-b border-line bg-chalk px-4 pt-7 pb-5.5 md:px-8">
        <p class="label mb-1.5">Saison {team.season}</p>
        <h1 class="heading text-4xl leading-tight md:text-5xl">Übersicht</h1>
        {teams.length > 1 && (
          <nav class="mt-4 flex flex-wrap gap-2" aria-label="Team">
            {teams.map((t) => (
              <a
                href={`/trainer?team=${t.id}`}
                aria-current={t.id === team.id ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-full border-2 px-5 font-semibold no-underline',
                  t.id === team.id
                    ? 'border-forest bg-forest text-white hover:text-white'
                    : 'border-pill bg-white text-ink hover:text-ink',
                ]}
              >
                {t.name}
              </a>
            ))}
          </nav>
        )}
      </div>

      <div class="flex flex-col gap-8 px-4 py-6 md:px-8">
        <div class="grid gap-3 md:grid-cols-3">
          <div class="flex flex-col gap-1 rounded-md border border-line p-4">
            <span class="label">Saison bestätigt</span>
            <strong class="font-condensed text-4xl text-ink">
              {confirmed}{' '}
              <span class="text-lg font-semibold text-text-light">
                von {players.length} Kindern
              </span>
            </strong>
            <div class="mt-1 h-2.5 overflow-hidden rounded-full bg-line">
              <div
                class="h-2.5 bg-jersey"
                style={{ width: `${players.length ? (confirmed / players.length) * 100 : 0}%` }}
              />
            </div>
          </div>
          <div class="flex flex-col gap-1 rounded-md border border-line p-4">
            <span class="label">Nächstes Spiel</span>
            {nextGame && next ? (
              <>
                <a href={`/trainer/termin/${nextGame.id}`} class="text-lg font-semibold">
                  {weekday(nextGame.startsAt)} {shortDate(nextGame.startsAt)} {nextGame.title} →
                </a>
                <span class="text-[15px]">
                  <strong class="text-jersey">{next.in.length} dabei</strong> · {next.out.length}{' '}
                  nicht dabei · {next.open.length} offen
                </span>
                {nextGame.minPlayers && (
                  <span
                    class:list={[
                      'text-[15px] font-semibold',
                      next.in.length >= nextGame.minPlayers ? 'text-jersey' : 'text-rust',
                    ]}
                  >
                    {next.in.length >= nextGame.minPlayers
                      ? `Genug Spieler (min. ${nextGame.minPlayers})`
                      : `Noch ${nextGame.minPlayers - next.in.length} bis ${nextGame.minPlayers} Spieler`}
                  </span>
                )}
              </>
            ) : (
              <span>Kein Spiel geplant.</span>
            )}
          </div>
          <div class="flex flex-col gap-1 rounded-md border border-line p-4">
            <span class="label">WhatsApp-Gruppe</span>
            <span class="text-[15px]">Aufruf an alle, die Saison zu bestätigen.</span>
            <details class="mt-1">
              <summary class="cursor-pointer font-semibold text-jersey">Text anzeigen</summary>
              <p class="mt-2 rounded bg-chalk p-3 text-[15px] whitespace-pre-line">{waText}</p>
              <a
                href={whatsAppShareUrl(waText ?? '')}
                target="_blank"
                rel="noreferrer"
                class="mt-2 inline-flex min-h-11 items-center rounded border-2 border-jersey px-4 font-condensed text-lg font-semibold tracking-[0.04em] text-jersey uppercase no-underline"
              >
                In WhatsApp teilen
              </a>
            </details>
          </div>
        </div>

        <section>
          <h2 class="heading text-[26px]">Spiele</h2>
          <p class="mb-3 text-[15px] text-text-light">
            ✓ dabei · ✗ nicht dabei · – offen. Auf ein Datum klicken für Details.
          </p>
          <div class="overflow-x-auto rounded-md border border-line">
            <table class="w-full border-collapse text-[15px]">
              <thead>
                <tr class="bg-chalk">
                  <th
                    scope="col"
                    class="sticky left-0 bg-chalk px-3 py-2 text-left font-semibold text-ink"
                  >
                    Kind
                  </th>
                  {games.map((g) => (
                    <th scope="col" class="px-1 py-2 text-center font-normal">
                      <a
                        href={`/trainer/termin/${g.id}`}
                        class="flex flex-col leading-tight no-underline"
                      >
                        <strong class:list={[g.cancelled && 'line-through']}>
                          {shortDate(g.startsAt)}
                        </strong>
                        <span class="text-xs text-text-light">{short(g.title)}</span>
                      </a>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {players.map((p) => (
                  <tr class="border-t border-line">
                    <th
                      scope="row"
                      class="sticky left-0 bg-white px-3 py-1.5 text-left font-semibold whitespace-nowrap text-ink"
                    >
                      {p.name}
                    </th>
                    {games.map((g) => {
                      const status = g.cancelled ? null : (statusOf(g, p.id, answers) ?? 'open');
                      return (
                        <td class="px-1 py-1.5 text-center">
                          {status && (
                            <span
                              aria-label={LABEL[status]}
                              class:list={[
                                'inline-flex size-8 items-center justify-center rounded font-bold',
                                status === 'in' && 'bg-[#E3EFDA] text-jersey',
                                status === 'out' && 'bg-[#F6E3D6] text-rust-dark',
                                status === 'open' &&
                                  'border border-dashed border-[#A9ACA4] text-text-light',
                              ]}
                            >
                              {SYMBOL[status]}
                            </span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
                <tr class="border-t-2 border-line bg-chalk">
                  <th
                    scope="row"
                    class="sticky left-0 bg-chalk px-3 py-2 text-left font-semibold text-ink"
                  >
                    Zusagen
                  </th>
                  {games.map((g) => {
                    const yes = groupByStatus(g, players, answers).in.length;
                    return (
                      <td
                        class:list={[
                          'py-2 text-center font-bold',
                          g.minPlayers && yes < g.minPlayers ? 'text-rust' : 'text-jersey',
                        ]}
                      >
                        {g.cancelled ? '' : yes}
                      </td>
                    );
                  })}
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <div class="grid gap-8 md:grid-cols-2">
          <section>
            <h2 class="heading mb-3 text-[26px]">Nächste Trainings</h2>
            <ul>
              {trainings.map((t) => {
                const out = groupByStatus(t, players, answers).out.length;
                return (
                  <li class="flex min-h-12 items-center justify-between gap-3 border-b border-line py-2">
                    <a href={`/trainer/termin/${t.id}`} class="font-semibold">
                      {weekday(t.startsAt)} {shortDate(t.startsAt)}, {time(t.startsAt)}
                    </a>
                    <span
                      class:list={[
                        'text-[15px]',
                        t.cancelled ? 'text-text-light' : out ? 'text-rust' : 'text-jersey',
                      ]}
                    >
                      {t.cancelled
                        ? `Fällt aus${t.cancelReason ? ` · ${t.cancelReason}` : ''}`
                        : out
                          ? `${out} abgemeldet`
                          : 'Alle dabei'}
                    </span>
                  </li>
                );
              })}
              {trainings.length === 0 && <li>Keine Trainings geplant.</li>}
            </ul>
          </section>
          <section>
            <h2 class="heading mb-3 text-[26px]">Späte Änderungen</h2>
            <p class="mb-2 text-[15px] text-text-light">Antworten nach dem Stichtag.</p>
            <ul>
              {late.map((l) => (
                <li class="flex flex-col border-b border-line py-2 text-[15px]">
                  <span>
                    <strong class="text-ink">{l.player}</strong> ·{' '}
                    {l.event &&
                      `${weekday(l.event.startsAt)} ${shortDate(l.event.startsAt)} ${l.event.title}`}
                    :{' '}
                    <span class={l.status === 'in' ? 'text-jersey' : 'text-rust'}>
                      {LABEL[l.status]}
                    </span>
                  </span>
                  <span class="text-sm text-text-light">
                    {weekday(l.updatedAt)} {shortDate(l.updatedAt)}, {time(l.updatedAt)}
                  </span>
                </li>
              ))}
              {late.length === 0 && <li class="text-[15px]">Keine.</li>}
            </ul>
          </section>
        </div>
      </div>
    </>
  )}
</Base>
