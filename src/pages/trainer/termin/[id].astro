---
// One event for coaches (mockup: Trainer-Termin.dc.html): who is in, out or still open, the coach
// note and a ready-made WhatsApp text. The note form posts to this page (no JavaScript needed).
// Not yet: push to the families when the note changes – follows with push.
import Base from '../../../layouts/Base.astro';
import { eventWhatsAppText, groupByStatus, whatsAppShareUrl } from '../../../lib/answers.ts';
import { canSeeTeam, coachTeams, eventDetail, setCoachNote } from '../../../lib/coach.ts';
import { getDb } from '../../../lib/db/index.ts';
import { deadline, longDate, shortDate, time, weekday } from '../../../lib/format.ts';
import { needsAnswer } from '../../../lib/season.ts';

const { coach } = Astro.locals;
if (!coach) return Astro.redirect('/trainer');

const db = await getDb();
const teams = await coachTeams(db, coach);
const id = Astro.params.id ?? '';
const isUuid = /^[0-9a-f-]{36}$/i.test(id);
const detail = isUuid ? await eventDetail(db, id) : undefined;
if (!detail || !canSeeTeam(coach, teams, detail.event.teamId)) {
  return new Response('Termin nicht gefunden', { status: 404 });
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const note = String(form.get('note') ?? '').trim();
  await setCoachNote(db, id, note || null);
  return Astro.redirect(`/trainer/termin/${id}?gespeichert=1`);
}
const saved = Astro.url.searchParams.has('gespeichert');

const { event, players, answers, phones } = detail;
const team = teams.find((t) => t.id === event.teamId);
const groups = groupByStatus(event, players, answers);
const lateIds = new Set(answers.filter((a) => a.late).map((a) => a.playerId));
const isGame = needsAnswer(event.type);
const kind = { game: 'Spiel', training: 'Training', tournament: 'Turnier', other: 'Termin' }[
  event.type
];
const where =
  event.homeAway === 'home' ? ' · Heim' : event.homeAway === 'away' ? ' · Auswärts' : '';
const waText = eventWhatsAppText(event, groups.open);
const nudge = (firstName: string) =>
  `Hallo, hier ist ${coach.name} von den Kangaroos. Kommt ${firstName} am ${weekday(event.startsAt)} ${shortDate(event.startsAt)} zu „${event.title}“? Kurz hier antworten oder im Teamplaner eintragen. Danke!`;
---

<Base title={`${event.title} · Trainer`} who={`Trainerbereich · ${coach.name}`} wide>
  <div class="border-b border-line bg-chalk px-4 pt-5 pb-6 md:px-8">
    <a href={`/trainer?team=${event.teamId}`} class="font-semibold">
      ← Übersicht {team?.name}
    </a>
    <p class="label mt-4 mb-1.5">
      {kind}
      {where} · {longDate(event.startsAt)}
    </p>
    <h1
      class:list={['heading text-4xl leading-tight md:text-5xl', event.cancelled && 'line-through']}
    >
      {event.title}
    </h1>
    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[15px]">
      {event.meetAt && (
        <span>
          <strong class="text-ink">Treffpunkt</strong> {time(event.meetAt)}
        </span>
      )}
      <span>
        <strong class="text-ink">Beginn</strong> {time(event.startsAt)}
      </span>
      {event.locationName && (
        <span>
          <strong class="text-ink">Ort</strong>{' '}
          {event.locationUrl ? (
            <a href={event.locationUrl} target="_blank" rel="noreferrer">
              {event.locationName}
            </a>
          ) : (
            event.locationName
          )}
        </span>
      )}
      {event.respondBy && (
        <span>
          <strong class="text-ink">Stichtag</strong> {deadline(event.respondBy)}
        </span>
      )}
    </div>
  </div>

  <div class="flex flex-col gap-8 px-4 py-6 md:px-8">
    {event.cancelled ? (
      <p class="rounded-md bg-note-bg p-4 font-semibold text-rust-dark">
        Fällt aus{event.cancelReason && ` · ${event.cancelReason}`}
      </p>
    ) : (
      <>
        {isGame && event.minPlayers && (
          <p
            class:list={[
              'rounded-md p-4 font-semibold',
              groups.in.length >= event.minPlayers
                ? 'bg-success-bg text-forest'
                : 'bg-note-bg text-rust-dark',
            ]}
          >
            {groups.in.length >= event.minPlayers
              ? `Genug Spieler · ${groups.in.length} von min. ${event.minPlayers}`
              : `Noch ${event.minPlayers - groups.in.length} Zusagen bis ${event.minPlayers} Spieler`}
            {groups.open.length > 0 && ` · ${groups.open.length} noch offen`}
          </p>
        )}
        <div class:list={['grid gap-6', isGame ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
          <section>
            <h2 class="heading mb-2 text-2xl">Dabei · {groups.in.length}</h2>
            <ul class="text-[15px]">
              {groups.in.map((p) => (
                <li class="border-b border-line py-1.5">
                  {p.name}
                  {lateIds.has(p.id) && <span class="text-text-light"> – nach Stichtag</span>}
                </li>
              ))}
            </ul>
          </section>
          <section>
            <h2 class="heading mb-2 text-2xl">
              {isGame ? 'Nicht dabei' : 'Abgemeldet'} · {groups.out.length}
            </h2>
            <ul class="text-[15px]">
              {groups.out.map((p) => (
                <li class="border-b border-line py-1.5">
                  {p.name}
                  {lateIds.has(p.id) && <span class="text-rust"> – nach Stichtag</span>}
                </li>
              ))}
            </ul>
          </section>
          {isGame && (
            <section>
              <h2 class="heading mb-2 text-2xl text-rust">Offen · {groups.open.length}</h2>
              <ul class="text-[15px]">
                {groups.open.map((p) => {
                  const phone = phones.get(p.id);
                  return (
                    <li class="flex items-center justify-between gap-2 border-b border-line py-1.5">
                      {p.name}
                      {phone ? (
                        <a
                          href={whatsAppShareUrl(nudge(p.name.split(' ')[0]), phone)}
                          target="_blank"
                          rel="noreferrer"
                          class="text-sm font-semibold"
                        >
                          Per WhatsApp anstoßen
                        </a>
                      ) : (
                        <span class="text-sm text-text-light">keine Nummer hinterlegt</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
        </div>
      </>
    )}

    <div class="grid gap-6 md:grid-cols-2">
      <form method="post" class="flex flex-col gap-2 rounded-md border border-line p-4">
        <h2 class="heading text-2xl">Hinweis am Termin</h2>
        <label for="note" class="text-[15px]">
          Alle Familien im Team sehen den Hinweis beim Termin. Leer lassen zum Entfernen.
        </label>
        <textarea
          id="note"
          name="note"
          rows="3"
          maxlength="500"
          class="rounded border-2 border-pill p-3 text-ink focus:border-jersey focus:outline-none"
        >{event.coachNote ?? ''}</textarea>
        <button
          type="submit"
          class="min-h-12 rounded bg-rust font-condensed text-lg font-semibold tracking-[0.04em] text-white uppercase hover:bg-rust-dark"
        >
          Speichern
        </button>
        {saved && (
          <p
            role="status"
            class="rounded bg-success-bg px-3 py-2 text-[15px] font-semibold text-ink"
          >
            Gespeichert.
          </p>
        )}
      </form>
      <div class="flex flex-col gap-2 rounded-md border border-line p-4">
        <h2 class="heading text-2xl">WhatsApp-Text</h2>
        <p class="rounded bg-chalk p-3 text-[15px] whitespace-pre-line">{waText}</p>
        <a
          href={whatsAppShareUrl(waText)}
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-12 items-center justify-center rounded border-2 border-jersey font-condensed text-lg font-semibold tracking-[0.04em] text-jersey uppercase no-underline"
        >
          In WhatsApp teilen
        </a>
        <span class="text-sm text-text-light">
          Öffnet WhatsApp mit diesem Text – Gruppe auswählen und senden.
        </span>
      </div>
    </div>
  </div>
</Base>
