---
// "Termin bearbeiten" (mockup: Trainer-Termin.dc.html): change day, times, place, deadline. If a
// game moves, families with a "Dabei" get a mail (lib/event-change.ts).
import { LINK_KEY } from 'astro:env/server';
import EventForm from '../../../../components/EventForm.astro';
import Base from '../../../../layouts/Base.astro';
import { applyAbsencesToEvents } from '../../../../lib/absence.ts';
import { updateEvent } from '../../../../lib/admin/data.ts';
import { canSeeTeam, coachTeams, eventDetail } from '../../../../lib/coach.ts';
import { getDb } from '../../../../lib/db/index.ts';
import { isMoved, notifyMoved } from '../../../../lib/event-change.ts';
import {
  eventFormValues,
  parseEventForm,
  type EventFormErrors,
  type EventFormValues,
} from '../../../../lib/event-form.ts';
import { sendMail } from '../../../../lib/mail.ts';

const { coach } = Astro.locals;
if (!coach) return Astro.redirect('/trainer');

const db = await getDb();
const teams = await coachTeams(db, coach);
const id = Astro.params.id ?? '';
const detail = /^[0-9a-f-]{36}$/i.test(id) ? await eventDetail(db, id) : undefined;
if (!detail || !canSeeTeam(coach, teams, detail.event.teamId)) {
  return new Response('Termin nicht gefunden', { status: 404 });
}
const before = detail.event;
const team = teams.find((t) => t.id === before.teamId);

let values: EventFormValues = eventFormValues(before);
let errors: EventFormErrors = {};
if (Astro.request.method === 'POST') {
  const result = parseEventForm(await Astro.request.formData(), before.type, false);
  if (result.ok) {
    await updateEvent(db, id, result.fields);
    const after = (await eventDetail(db, id))!.event;
    // A new day can fall into an entered absence
    if (after.startsAt !== before.startsAt) await applyAbsencesToEvents(db, [id]);
    let mailed = '';
    if (isMoved(before, after)) {
      const { sent, failed } = await notifyMoved(db, after, team?.name ?? '', {
        origin: Astro.url.origin,
        key: LINK_KEY,
        send: sendMail,
      });
      mailed = `&informiert=${sent}${failed ? `&fehler=${failed}` : ''}`;
    }
    return Astro.redirect(`/trainer/termin/${id}?geaendert=1${mailed}`);
  }
  values = result.values;
  errors = result.errors;
}
---

<Base title={`${before.title} bearbeiten · Trainer`} who={`Trainerbereich · ${coach.name}`} wide>
  <div class="border-b border-line bg-chalk px-4 pt-5 pb-6 md:px-8">
    <a href={`/trainer/termin/${id}`} class="font-semibold">
      ← {before.title}
    </a>
    <h1 class="heading mt-4 text-4xl leading-tight md:text-5xl">Termin bearbeiten</h1>
    <p class="mt-2 text-[15px]">
      Wird ein Spiel verlegt (Tag, Uhrzeit, Treffpunkt oder Ort), bekommen die Familien mit Zusage
      eine Mail und können absagen, falls es nicht mehr passt.
    </p>
  </div>
  <div class="px-4 py-6 md:px-8">
    {Object.keys(errors).length > 0 && (
      <p role="alert" class="mb-4 rounded-md bg-note-bg p-4 font-semibold text-rust-dark">
        Bitte die markierten Felder prüfen.
      </p>
    )}
    <EventForm
      values={values}
      errors={errors}
      chooseType={false}
      submitLabel="Speichern"
      cancelHref={`/trainer/termin/${id}`}
    />
  </div>
</Base>
