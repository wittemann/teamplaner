---
// Shell for every page: head, fonts, header with the crest (docs/design.md, "Kopfzeile").
import { Font } from 'astro:assets';
import '../styles/global.css';

type Props = {
  title: string;
  /** Shown on the right of the header, e.g. "Familie Müller" */
  who?: string;
  /** Coach pages: the season matrix needs more width than the phone-first parent page */
  wide?: boolean;
};

const { title, who, wide = false } = Astro.props;
// The manifest carries the personal link of the cookie, so it must be fetched with cookies
const coachArea = Astro.url.pathname.startsWith('/trainer');
const manifest = coachArea ? '/manifest.webmanifest?bereich=trainer' : '/manifest.webmanifest';
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Personal pages: never in search engines (docs/tech.md, "Datenschutz") -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- The token in /f/<token> must not leak to other sites through the Referer header -->
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#23461E" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/crest.png" />
    <link rel="manifest" href={manifest} crossorigin="use-credentials" />
    <!-- iPhone home screen: icon with white background, name as in the manifest -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="apple-mobile-web-app-title"
      content={coachArea ? 'Kangaroos Trainer' : 'Teamplaner'}
    />
    <Font cssVariable="--font-barlow" preload />
    <Font cssVariable="--font-barlow-condensed" preload />
  </head>
  <body>
    <header class="flex h-16 items-center justify-between gap-3 bg-forest px-4 text-white">
      <div class="flex items-center gap-2.5">
        <span class="flex size-10 items-center justify-center overflow-hidden rounded-full bg-white">
          <img src="/crest.png" alt="" class="size-[34px] object-contain" />
        </span>
        <span class="font-condensed text-lg leading-none font-bold tracking-[0.04em] uppercase">
          Bretten
          <br />
          Kangaroos
        </span>
      </div>
      {who && <span class="text-[15px] text-[#C7D8B8]">{who}</span>}
    </header>
    <main class:list={['mx-auto', wide ? 'max-w-6xl' : 'max-w-xl']}>
      <slot />
    </main>
    <script>
      // Tapped notification (public/sw.js): load the address fresh, even if it is this page
      navigator.serviceWorker?.addEventListener('message', (event) => {
        if (event.data?.type === 'open') location.assign(event.data.url);
      });
      // Back from memory (iPhone app switcher, back button): the answers may have changed since
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) location.reload();
      });
    </script>
  </body>
</html>
